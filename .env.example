VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only — funções em api/*.js (NUNCA prefixar com VITE_, não pode ir pro bundle)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Cifra PII em repouso (api/_crypto.js) — hex de 64 chars (32 bytes). Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcd

# WhatsApp (Meta Cloud API) — server-only, api/_whatsapp-provider.js + api/whatsapp-webhook.js
WHATSAPP_VERIFY_TOKEN=       # segredo compartilhado do handshake GET de verificação
META_APP_SECRET=             # chave HMAC pra validar X-Hub-Signature-256
META_ACCESS_TOKEN=           # token de usuário de sistema (longa duração), envia mensagens
META_PHONE_NUMBER_ID=        # id do número de WhatsApp Business cadastrado
META_API_VERSION=v21.0       # graph.facebook.com/{version}/... — fixar, não hardcodar inline

# Extração de respostas do bot de qualificação — api/whatsapp-webhook.js
ANTHROPIC_API_KEY=
